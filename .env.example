# Speed Run Heaven build settings. All optional. On GitHub, set them as repository *variables* (none is a secret).
SITE_URL=          # canonical address, no trailing slash; default https://theguysaccount.github.io/speed-run-heaven-civic-game
STAGED=            # "true" marks every page noindex and publishes no sitemap (only for a copy of a site live elsewhere)
SUPPORT_URL=       # the money slot: an https link (e.g. a pay-what-you-want itch.io page) shown in the footer
SUPPORT_LABEL=     # its label; default "SUPPORT THE GAME"
GOATCOUNTER_URL=   # https://<code>.goatcounter.com/count turns on cookieless counts; empty loads no analytics
OUT_DIR=           # build output folder; default dist/
CHROME=            # path to Chrome or Chromium for the tests and screenshots, if it is not found automatically
